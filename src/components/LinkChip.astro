---
// Funky, type-aware link chip with a springy hover micro-interaction.
// The icon is inferred from the label so a paper looks like a paper,
// code like code, a demo like a play button, etc.
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
const l = label.toLowerCase();

type IconKey = 'paper' | 'code' | 'demo' | 'hf' | 'blog' | 'slides' | 'press' | 'site' | 'link';

function pick(): IconKey {
  if (/(github|\bcode\b)/.test(l)) return 'code';
  if (/(arxiv|paper|nature|pmc|anthology|proceedings|openreview|\.pdf)/.test(l)) return 'paper';
  if (/(hugging face|\bhf\b)/.test(l)) return 'hf';
  if (/(demo|live|colab|watch|talks?)/.test(l)) return 'demo';
  if (/(blog|blogpost)/.test(l)) return 'blog';
  if (/(slides|deck)/.test(l)) return 'slides';
  if (/(time|techcrunch|mit tech|venturebeat|ars technica|engineering|award|wikimedia|best invention|reuters|wired|\b20\d\d\b)/.test(l)) return 'press';
  if (/(website|\bsite\b|\.io|muse|meta\.ai|bigscience|bloom on|africanlp)/.test(l)) return 'site';
  return 'link';
}

// Feather-style single-color stroke icons (24x24).
const icons: Record<IconKey, string> = {
  paper: '<path d="M14 3v5h5"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><path d="M9 13h6M9 17h6"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  demo: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  hf: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
  blog: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  slides: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  press: '<circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/>',
  site: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20z"/>',
  link: '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>',
};

const icon = pick();
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="chip inline-flex items-center gap-1.5 rounded-md border border-border bg-bg-subtle px-2.5 py-1 font-mono text-[11px] text-ink-soft"
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="chip-ico h-3.5 w-3.5 shrink-0 text-muted-2"
    aria-hidden="true"
    set:html={icons[icon]}
  ></svg>
  <span>{label}</span>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="chip-arrow h-3 shrink-0"
    aria-hidden="true"
  ><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg>
</a>

<style>
  .chip {
    position: relative;
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    box-shadow: 0 5px 16px -7px var(--color-accent);
  }
  .chip-ico {
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.18s ease;
  }
  .chip:hover .chip-ico {
    color: var(--color-accent);
  }
  /* Trailing "opens externally" arrow slides + fades in on hover. */
  .chip-arrow {
    width: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: width 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip:hover {
      transform: translateY(-2px);
    }
    .chip:hover .chip-ico {
      transform: scale(1.18) rotate(-7deg);
    }
    .chip:hover .chip-arrow {
      width: 0.75rem;
      opacity: 1;
      transform: translateX(0);
    }
    .chip:active {
      transform: translateY(0) scale(0.97);
    }
  }
</style>
