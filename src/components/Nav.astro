---
import { withBase } from '../lib/url.ts';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string): boolean => {
  const normalized = href.replace(/\/+$/, '') || '/';
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(normalized + '/');
};

const links = [
  { href: '/', label: 'Home' },
  { href: '/#projects', label: 'Projects', isHash: true },
  { href: '/#research', label: 'Research', isHash: true },
  // Temporarily disabled — re-enable when Writing/Talks are ready:
  // { href: '/posts', label: 'Writing' },
  // { href: '/talks', label: 'Talks' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto max-w-[900px] px-6 h-[56px] flex items-center justify-end gap-6">
    <div class="flex items-center gap-1">
      <nav class="flex items-center gap-1 text-[13.5px]" aria-label="Primary">
        {links.map((link) => {
          const active = !link.isHash && isActive(link.href);
          const spy = link.isHash ? link.href.split('#')[1] : undefined;
          return (
            <a
              href={withBase(link.href)}
              data-spy={spy}
              class={active
                ? 'px-2.5 py-1.5 text-ink font-medium'
                : 'px-2.5 py-1.5 text-muted hover:text-ink transition-colors'}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        class="ml-1 grid place-items-center h-8 w-8 rounded-full border border-border text-muted hover:text-ink hover:border-ink transition-colors"
      >
        <svg class="theme-ico-light h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-ico-dark h-[15px] w-[15px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>
