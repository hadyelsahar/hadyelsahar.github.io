---
// Minimal, in-page invisible-watermarking demo (no iframe, no overlay).
// Image watermarking with Meta VideoSeal 1.0, running 100% in the browser via
// ONNX Runtime Web. Inference logic reused from the standalone VideoSeal demo.
import { withBase } from '../lib/url.ts';

const cfg = {
  embedder: withBase('/assets/demos/videoseal/embedder.fp16.onnx'),
  detector: withBase('/assets/demos/videoseal/detector.fp16.onnx'),
  gallery: withBase('/assets/demos/videoseal/gallery/gallery.json'),
  galleryDir: withBase('/assets/demos/videoseal/gallery/'),
};
---

<section id="watermark-demo" class="wd-collapse mx-auto max-w-[720px] px-6 pt-3 pb-14 scroll-mt-24">
  <div class="text-center">
    <h2 class="font-display text-[26px] md:text-[30px] font-semibold tracking-[-0.01em] text-ink">Try invisible watermarking</h2>
  </div>

  <div class="mt-6 rounded-[14px] border border-border bg-card overflow-hidden">
    <div class="flex border-b border-border">
      <button data-tab="image" class="wd-tab flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 font-mono text-[12px] text-ink border-b-2 border-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        Image · VideoSeal
      </button>
      <button data-tab="audio" class="wd-tab flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 font-mono text-[12px] text-muted border-b-2 border-transparent hover:text-ink transition-colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0"><path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/></svg>
        Audio · AudioSeal
      </button>
    </div>
    <div id="wd-panel-image">
    <!-- load gate -->
    <div id="wd-loader" class="p-8 text-center">
      <button id="wd-load" class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent-soft px-4 py-2 font-mono text-[12.5px] text-accent hover:bg-accent hover:text-bg transition-colors">
        ▶ Load VideoSeal 1.0 (67 MB, cached)
      </button>
      <div id="wd-load-progress" class="mt-4 hidden mx-auto max-w-[360px]">
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-border"><div id="wd-load-bar" class="h-full w-0 bg-accent transition-[width] duration-150"></div></div>
        <p id="wd-load-msg" class="mt-2 font-mono text-[11px] text-muted"></p>
      </div>
    </div>

    <!-- demo -->
    <div id="wd-demo" class="hidden p-4 sm:p-5">
      <div id="wd-gallery" class="flex flex-wrap gap-2 justify-center"></div>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-[256px_1fr] gap-5 items-start">
        <div class="mx-auto">
          <div id="wd-curtain" class="relative w-[256px] h-[256px] rounded-[8px] border border-border overflow-hidden bg-figure cursor-ew-resize select-none touch-none">
            <canvas id="wd-view" width="256" height="256" class="absolute inset-0 w-full h-full [image-rendering:auto]"></canvas>
            <canvas id="wd-heat" width="256" height="256" class="absolute inset-0 w-full h-full [image-rendering:auto]" style="clip-path:inset(0 0 0 50%)"></canvas>
            <div id="wd-divider" class="pointer-events-none absolute inset-y-0 w-0.5 bg-white/85 shadow-[0_0_6px_rgba(0,0,0,.4)]" style="left:50%">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-7 w-7 rounded-full bg-white/95 shadow grid place-items-center text-[11px] text-ink">⇔</div>
            </div>
            <span class="pointer-events-none absolute bottom-1.5 left-2 font-mono text-[9px] uppercase tracking-wider text-white/90 [text-shadow:0_1px_2px_rgba(0,0,0,.7)]">image</span>
            <span class="pointer-events-none absolute bottom-1.5 right-2 font-mono text-[9px] uppercase tracking-wider text-white/90 [text-shadow:0_1px_2px_rgba(0,0,0,.7)]">the watermark</span>
            <div id="wd-cam" class="hidden absolute inset-0 z-20 bg-black flex flex-col">
              <video id="wd-cam-video" class="flex-1 min-h-0 w-full object-cover" playsinline muted></video>
              <div class="flex gap-2 p-2">
                <button id="wd-cam-shot" class="flex-1 rounded-md bg-accent text-bg font-mono text-[12px] py-1.5">📸 Capture</button>
                <button id="wd-cam-cancel" class="rounded-md border border-white/40 text-white font-mono text-[12px] px-3 py-1.5">✕</button>
              </div>
            </div>
            <div id="wd-embed-overlay" class="hidden absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-card/95 backdrop-blur-sm px-5 text-center">
              <div class="h-6 w-6 rounded-full border-2 border-accent border-t-transparent animate-spin"></div>
              <p id="wd-ovl-msg" class="font-mono text-[11px] text-ink-soft leading-snug">Downloading the watermark generator…</p>
              <div class="h-1.5 w-full max-w-[180px] overflow-hidden rounded-full bg-border"><div id="wd-ovl-bar" class="h-full w-0 bg-accent transition-[width] duration-150"></div></div>
              <p class="font-mono text-[9px] uppercase tracking-[0.15em] text-muted-2">runs 100% in your browser</p>
            </div>
          </div>
        </div>

        <div>
          <label class="block">
            <span class="font-mono text-[11px] text-ink-soft">JPEG quality <b id="wd-vq" class="text-accent">100</b></span>
            <input id="wd-jpeg" type="range" min="5" max="100" value="100" class="w-full accent-[var(--color-accent)]" />
          </label>
          <label class="block mt-3">
            <span class="font-mono text-[11px] text-ink-soft">Crop <b id="wd-vc" class="text-accent">100</b>%</span>
            <input id="wd-crop" type="range" min="40" max="100" value="100" class="w-full accent-[var(--color-accent)]" />
          </label>
          <label class="block mt-3">
            <span class="font-mono text-[11px] text-ink-soft">Rotate <b id="wd-vr" class="text-accent">0</b>°</span>
            <input id="wd-rot" type="range" min="-45" max="45" value="0" class="w-full accent-[var(--color-accent)]" />
          </label>
          <input id="wd-upload" type="file" accept="image/*" class="hidden" />

          <button id="wd-detect" class="mt-4 w-full inline-flex items-center justify-center gap-2 rounded-md border border-accent bg-accent-soft px-4 py-2 font-mono text-[12.5px] text-accent hover:bg-accent hover:text-bg transition-colors">🔍 Detect the watermark</button>
          <div class="mt-3 rounded-[10px] border border-border bg-bg-subtle p-4">
            <div class="flex items-end justify-between">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Bits recovered</p>
                <p class="mt-1"><span id="wd-acc" class="font-display text-[30px] font-semibold text-ink leading-none">--</span><span class="text-[14px] text-muted"> / 256</span></p>
              </div>
              <p id="wd-verdict" class="font-mono text-[11px] px-2.5 py-1 rounded-full border border-border text-muted">idle</p>
            </div>
            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-border"><div id="wd-accbar" class="h-full w-0 transition-[width] duration-300" style="background:var(--color-accent)"></div></div>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Hidden message · 256 bits</p>
            <p id="wd-bitstring" class="mt-1 font-mono text-[9px] leading-[1.5] break-all rounded-md p-2.5" style="background:#0b1220;color:#94a3b8">press “Detect the watermark” to read the hidden bits</p>
          </div>
        </div>
      </div>
    </div>
    </div>
    <div id="wd-panel-audio" class="hidden">
      <div id="wa-loader" class="p-8 text-center">
        <button id="wa-load" class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent-soft px-4 py-2 font-mono text-[12.5px] text-accent hover:bg-accent hover:text-bg transition-colors">▶ Load AudioSeal (46 MB, cached)</button>
        <div id="wa-load-progress" class="mt-4 hidden mx-auto max-w-[360px]">
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-border"><div id="wa-load-bar" class="h-full w-0 bg-accent transition-[width] duration-150"></div></div>
          <p id="wa-load-msg" class="mt-2 font-mono text-[11px] text-muted"></p>
        </div>
      </div>
      <div id="wa-demo" class="hidden p-4 sm:p-5">
        <div id="wa-gallery" class="flex flex-wrap gap-2 justify-center"></div>
        <div class="relative mt-5 rounded-[8px] border border-border bg-figure p-3">
          <canvas id="wa-wave" width="560" height="110" class="w-full h-[110px]"></canvas>
          <div id="wa-overlay" class="hidden absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-card/95 backdrop-blur-sm px-5 text-center">
            <div class="h-6 w-6 rounded-full border-2 border-accent border-t-transparent animate-spin"></div>
            <p id="wa-ovl-msg" class="font-mono text-[11px] text-ink-soft">Watermarking…</p>
            <div class="h-1.5 w-full max-w-[180px] overflow-hidden rounded-full bg-border"><div id="wa-ovl-bar" class="h-full w-0 bg-accent transition-[width] duration-150"></div></div>
          </div>
          <div id="wa-mic" class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-black/90 px-5 text-center">
            <div class="h-3 w-3 rounded-full bg-red-500 animate-pulse"></div>
            <p class="font-mono text-[12px] text-white">● Recording…</p>
            <button id="wa-mic-stop" class="rounded-md bg-accent text-bg font-mono text-[12px] px-4 py-1.5">■ Stop &amp; watermark</button>
          </div>
        </div>
        <div class="mt-2 flex flex-wrap gap-2 justify-center font-mono text-[11px]">
          <button id="wa-play-orig" class="px-2.5 py-1 rounded border border-border hover:border-ink transition-colors">▶ original</button>
          <button id="wa-play-wm" class="px-2.5 py-1 rounded border border-accent text-accent hover:bg-accent-soft transition-colors">▶ watermarked</button>
          <button id="wa-stop" class="px-2.5 py-1 rounded border border-border hover:border-ink transition-colors">■ stop</button>
        </div>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-3">
          <label class="block"><span class="font-mono text-[11px] text-ink-soft">Background noise <b id="wa-vn" class="text-accent">0</b></span><input id="wa-noise" type="range" min="0" max="60" value="0" class="w-full accent-[var(--color-accent)]" /></label>
          <label class="block"><span class="font-mono text-[11px] text-ink-soft">Keep first <b id="wa-vc" class="text-accent">100</b>%</span><input id="wa-crop" type="range" min="20" max="100" value="100" class="w-full accent-[var(--color-accent)]" /></label>
        </div>
        <button id="wa-detect" class="mt-4 w-full inline-flex items-center justify-center gap-2 rounded-md border border-accent bg-accent-soft px-4 py-2 font-mono text-[12.5px] text-accent hover:bg-accent hover:text-bg transition-colors">🔍 Detect the watermark</button>
        <div class="mt-3 rounded-[10px] border border-border bg-bg-subtle p-4">
          <div class="flex items-end justify-between">
            <div><p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Bits recovered</p><p class="mt-1"><span id="wa-acc" class="font-display text-[30px] font-semibold text-ink leading-none">--</span><span class="text-[14px] text-muted"> / 16</span></p></div>
            <p id="wa-verdict" class="font-mono text-[11px] px-2.5 py-1 rounded-full border border-border text-muted">idle</p>
          </div>
          <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-border"><div id="wa-accbar" class="h-full w-0 transition-[width] duration-300" style="background:var(--color-accent)"></div></div>
          <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Hidden message · 16 bits</p>
          <p id="wa-bitstring" class="mt-1 font-mono text-[13px] tracking-[0.2em] break-all rounded-md p-2.5" style="background:#0b1220;color:#94a3b8">press “Detect the watermark” to read the hidden bits</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-reveal-demo]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      var s = document.getElementById('watermark-demo');
      if (s) { s.classList.add('open'); setTimeout(function () { s.style.maxHeight = 'none'; }, 650); setTimeout(function () { s.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 60); }
    });
  });
</script>

<script type="application/json" id="wd-cfg" set:html={JSON.stringify(cfg)}></script>
<script is:inline>
  (function () {
    var cfg = JSON.parse(document.getElementById('wd-cfg').textContent);
    var ORT = '1.20.1';
    var ort = null, session = null, embedder = null, gallery = null, current = null;
    var bases = {}, lastAttacked = null, lastHeat = null;
    var $ = function (id) { return document.getElementById(id); };
    var work = document.createElement('canvas'); work.width = work.height = 256;
    var wctx = work.getContext('2d', { willReadFrequently: true });
    async function imgToData(url) { var im = new Image(); im.crossOrigin = 'anonymous'; im.src = url; await im.decode(); wctx.clearRect(0,0,256,256); wctx.drawImage(im,0,0,256,256); return wctx.getImageData(0,0,256,256); }

    async function jpeg(src, q) { var t = document.createElement('canvas'); t.width=t.height=256; t.getContext('2d').putImageData(src,0,0); var b = await new Promise(function(r){t.toBlob(r,'image/jpeg',q/100)}); var bmp = await createImageBitmap(b); var c = document.createElement('canvas'); c.width=c.height=256; var cx=c.getContext('2d'); cx.drawImage(bmp,0,0,256,256); return cx.getImageData(0,0,256,256); }
    function cropImg(src,pct){ if(pct>=100) return src; var keep=Math.round(256*pct/100); var off=Math.round((256-keep)/2); var t=document.createElement('canvas'); t.width=t.height=256; t.getContext('2d').putImageData(src,0,0); var c=document.createElement('canvas'); c.width=c.height=256; var cx=c.getContext('2d'); cx.drawImage(t,off,off,keep,keep,0,0,256,256); return cx.getImageData(0,0,256,256); }
    function rotateImg(src,deg){ if(!deg) return src; var t=document.createElement('canvas'); t.width=t.height=256; t.getContext('2d').putImageData(src,0,0); var c=document.createElement('canvas'); c.width=c.height=256; var cx=c.getContext('2d'); cx.save(); cx.translate(128,128); cx.rotate(deg*Math.PI/180); cx.drawImage(t,-128,-128); cx.restore(); return cx.getImageData(0,0,256,256); }

    function toTensor(d){ var data=d.data,n=256*256,f=new Float32Array(3*n); for(var i=0;i<n;i++){f[i]=data[i*4]/255;f[n+i]=data[i*4+1]/255;f[2*n+i]=data[i*4+2]/255;} return new ort.Tensor('float32',f,[1,3,256,256]); }
    function randomMessage(){ var bits=new Uint8Array(256),big=new BigInt64Array(256),rnd=new Uint8Array(256); crypto.getRandomValues(rnd); for(var i=0;i<256;i++){bits[i]=rnd[i]&1;big[i]=BigInt(bits[i]);} return {bits:bits,tensor:new ort.Tensor('int64',big,[1,256])}; }
    function tensorToImageData(t){ var d=t.data,n=256*256,out=new Uint8ClampedArray(4*n); for(var i=0;i<n;i++){out[i*4]=d[i]*255;out[i*4+1]=d[n+i]*255;out[i*4+2]=d[2*n+i]*255;out[i*4+3]=255;} return new ImageData(out,256,256); }
    function residualHeat(wm,orig,amp){ amp=amp||18; var a=wm.data,b=orig.data,out=new Uint8ClampedArray(a.length); for(var i=0;i<a.length;i+=4){out[i]=128+(a[i]-b[i])*amp;out[i+1]=128+(a[i+1]-b[i+1])*amp;out[i+2]=128+(a[i+2]-b[i+2])*amp;out[i+3]=255;} return new ImageData(out,256,256); }

    async function fetchModel(url,fallback,bar,msg,label){ var resp=await fetch(url); if(!resp.body||!resp.body.getReader){ if(bar) bar.style.width='100%'; if(msg) msg.textContent=label+' (cached)'; return new Uint8Array(await resp.arrayBuffer()); } var total=+resp.headers.get('content-length')||fallback; var reader=resp.body.getReader(),chunks=[],got=0; while(true){ var r=await reader.read(); if(r.done) break; chunks.push(r.value); got+=r.value.length; if(bar) bar.style.width=Math.min(100,got/total*100)+'%'; if(msg) msg.textContent=label+' '+(got/1e6|0)+' / '+(total/1e6|0)+' MB'; } var b=new Uint8Array(got),o=0; for(var c of chunks){b.set(c,o);o+=c.length;} return b; }
    function showOverlay(m){ var o=$('wd-embed-overlay'); if(o) o.classList.remove('hidden'); if(m) $('wd-ovl-msg').textContent=m; }
    function hideOverlay(){ var o=$('wd-embed-overlay'); if(o) o.classList.add('hidden'); }
    async function loadEmbedder(){ if(embedder) return embedder; var bar=$('wd-ovl-bar'),msg=$('wd-ovl-msg'); bar.style.width='0%'; msg.textContent='Downloading the watermark generator (47 MB)…'; var buf=await fetchModel(cfg.embedder,47380497,bar,msg,'Downloading generator…'); msg.textContent='Preparing generator…'; try{embedder=await ort.InferenceSession.create(buf,{executionProviders:['webgpu','wasm']});}catch(e){embedder=await ort.InferenceSession.create(buf,{executionProviders:['wasm']});} return embedder; }

    async function detect(){ if(!session||!lastAttacked) return; var v=$('wd-verdict'); v.textContent='reading…'; var out=await session.run({image:toTensor(lastAttacked)}); var preds=out.preds.data; var rec=new Uint8Array(256); for(var i=0;i<256;i++)rec[i]=preds[i+1]>0?1:0; var truth=current&&current.bits?current.bits:null; var correct=0,html=''; for(var i=0;i<256;i++){ var ok=truth?rec[i]===truth[i]:true; if(ok)correct++; var col=truth==null?'#94a3b8':(ok?'#34d399':'#f87171'); html+='<span style="color:'+col+'">'+rec[i]+'</span>'; } $('wd-bitstring').innerHTML=html; var acc=$('wd-acc'),bar=$('wd-accbar'); acc.textContent=truth?String(correct):'?'; var pct=truth?correct/256:1; bar.style.width=(pct*100)+'%'; var label,c2; if(pct>=0.9){label='✓ detected';c2='var(--color-accent)';}else if(pct>=0.68){label='~ degraded';c2='#c98a00';}else{label='✗ destroyed';c2='#d1495b';} bar.style.background=c2; v.textContent=label+' ('+Math.round(pct*100)+'%)'; v.style.color=c2; v.style.borderColor=c2; }

    function drawScene(){ if(lastAttacked) $('wd-view').getContext('2d').putImageData(lastAttacked,0,0); var h=lastHeat||bases.heat; if(h) $('wd-heat').getContext('2d').putImageData(h,0,0); }
    function setSplit(pct){ pct=Math.max(0,Math.min(100,pct)); $('wd-heat').style.clipPath='inset(0 0 0 '+pct+'%)'; $('wd-divider').style.left=pct+'%'; }
    function resetResult(){ $('wd-acc').textContent='--'; $('wd-accbar').style.width='0%'; var v=$('wd-verdict'); v.textContent='idle'; v.style.color=''; v.style.borderColor=''; $('wd-bitstring').textContent='press “Detect the watermark” to read the hidden bits'; }
    async function applyAttacks(){ if(!bases.wm) return; var cp=+$('wd-crop').value, rt=+$('wd-rot').value, q=+$('wd-jpeg').value; var img=bases.wm; if(cp<100) img=cropImg(img,cp); if(rt) img=rotateImg(img,rt); if(q<100) img=await jpeg(img,q); lastAttacked=img; var h=bases.heat; if(h){ if(cp<100) h=cropImg(h,cp); if(rt) h=rotateImg(h,rt); } lastHeat=h; drawScene(); resetResult(); }

    async function selectImage(item){ current={id:item.id,bits:item.bits?Uint8Array.from(item.bits,function(c){return +c}):null}; bases.wm=await imgToData(cfg.galleryDir+item.wm); bases.orig=await imgToData(cfg.galleryDir+item.orig); bases.heat=await imgToData(cfg.galleryDir+item.heat); $('wd-jpeg').value=100; $('wd-vq').textContent='100'; $('wd-crop').value=100; $('wd-vc').textContent='100'; $('wd-rot').value=0; $('wd-vr').textContent='0'; setSplit(50); await applyAttacks(); document.querySelectorAll('#wd-gallery .wd-th').forEach(function(t){t.classList.toggle('ring-2',t.dataset.id===item.id);}); }

    async function loadModel(){ $('wd-load').disabled=true; $('wd-load').style.opacity=.5; $('wd-load-progress').classList.remove('hidden'); var msg=$('wd-load-msg'),bar=$('wd-load-bar'); try{ msg.textContent='fetching ONNX Runtime…'; ort=await import('https://cdn.jsdelivr.net/npm/onnxruntime-web@'+ORT+'/dist/ort.mjs'); ort.env.wasm.numThreads=1; ort.env.wasm.wasmPaths='https://cdn.jsdelivr.net/npm/onnxruntime-web@'+ORT+'/dist/'; var buf=await fetchModel(cfg.detector,66887334,bar,msg,'downloading detector…'); msg.textContent='initializing…'; try{session=await ort.InferenceSession.create(buf,{executionProviders:['webgpu','wasm']});}catch(e){session=await ort.InferenceSession.create(buf,{executionProviders:['wasm']});} $('wd-loader').classList.add('hidden'); $('wd-demo').classList.remove('hidden'); gallery=await (await fetch(cfg.gallery)).json(); var g=$('wd-gallery'); gallery.images.forEach(function(item){ var b=document.createElement('button'); b.className='wd-th w-[60px] h-[60px] rounded-[6px] border border-border overflow-hidden ring-accent hover:ring-2'; b.dataset.id=item.id; b.innerHTML='<img src="'+cfg.galleryDir+item.wm+'" alt="'+item.id+'" class="w-full h-full object-cover" />'; b.addEventListener('click',function(){selectImage(item)}); g.appendChild(b); }); var plus=document.createElement('button'); plus.className='w-[60px] h-[60px] rounded-[6px] border border-dashed border-accent/60 text-accent grid place-items-center text-[24px] leading-none hover:bg-accent-soft transition-colors'; plus.title='Watermark your own image'; plus.setAttribute('aria-label','Watermark your own image'); plus.textContent='+'; plus.addEventListener('click',function(){$('wd-upload').click();}); g.appendChild(plus); var cam=document.createElement('button'); cam.className='w-[60px] h-[60px] rounded-[6px] border border-dashed border-accent/60 text-accent grid place-items-center text-[20px] leading-none hover:bg-accent-soft transition-colors'; cam.title='Take a photo'; cam.setAttribute('aria-label','Take a photo'); cam.textContent='📷'; cam.addEventListener('click',openCamera); g.appendChild(cam); await selectImage(gallery.images[0]); }catch(e){ msg.textContent='failed: '+(e&&e.message?e.message:e); $('wd-load').disabled=false; $('wd-load').style.opacity=1; } }

    $('wd-load').addEventListener('click', loadModel);
    $('wd-detect').addEventListener('click', detect);
    (function(){ var c=$('wd-curtain'), dragging=false; if(!c) return; function fromX(x){ var r=c.getBoundingClientRect(); setSplit((x-r.left)/r.width*100); } c.addEventListener('pointerdown',function(e){dragging=true; c.setPointerCapture(e.pointerId); fromX(e.clientX);}); c.addEventListener('pointermove',function(e){ if(dragging) fromX(e.clientX); }); c.addEventListener('pointerup',function(){dragging=false;}); c.addEventListener('pointercancel',function(){dragging=false;}); })();
    $('wd-jpeg').addEventListener('input',function(){$('wd-vq').textContent=$('wd-jpeg').value;});
    $('wd-jpeg').addEventListener('change',applyAttacks);
    $('wd-crop').addEventListener('input',function(){$('wd-vc').textContent=$('wd-crop').value;}); $('wd-crop').addEventListener('change',applyAttacks);
    $('wd-rot').addEventListener('input',function(){$('wd-vr').textContent=$('wd-rot').value;}); $('wd-rot').addEventListener('change',applyAttacks);
    async function embedImageAndShow(orig){ showOverlay('Reading your image...'); try{ await ensureOrt(); await loadEmbedder(); $('wd-ovl-msg').textContent='Watermarking your image in your browser...'; $('wd-ovl-bar').style.width='100%'; await sleep(40); var m=randomMessage(); var out=await embedder.run({image:toTensor(orig),message:m.tensor}); var wm=tensorToImageData(out.image_w); bases.orig=orig; bases.wm=wm; bases.heat=residualHeat(wm,orig); current={id:'you',bits:m.bits}; document.querySelectorAll('#wd-gallery .wd-th').forEach(function(t){t.classList.remove('ring-2');}); $('wd-jpeg').value=100;$('wd-vq').textContent='100'; $('wd-crop').value=100; $('wd-vc').textContent='100'; $('wd-rot').value=0; $('wd-vr').textContent='0'; setSplit(50); await applyAttacks(); hideOverlay(); }catch(err){ $('wd-ovl-msg').textContent='Failed: '+(err&&err.message?err.message:err); } }
    $('wd-upload').addEventListener('change',async function(e){ var f=e.target.files[0]; if(!f) return; var url=URL.createObjectURL(f); try{ var orig=await imgToData(url); await embedImageAndShow(orig); }finally{ URL.revokeObjectURL(url); } });
    var camStream=null;
    async function openCamera(){ try{ camStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:false}); var v=$('wd-cam-video'); v.srcObject=camStream; await v.play(); $('wd-cam').classList.remove('hidden'); }catch(e){ alert('Camera unavailable: '+e.message); } }
    function closeCamera(){ if(camStream){ camStream.getTracks().forEach(function(t){t.stop()}); camStream=null; } $('wd-cam').classList.add('hidden'); }
    async function shootCamera(){ var v=$('wd-cam-video'); var vw=v.videoWidth||256,vh=v.videoHeight||256,sz=Math.min(vw,vh); wctx.clearRect(0,0,256,256); wctx.drawImage(v,(vw-sz)/2,(vh-sz)/2,sz,sz,0,0,256,256); var orig=wctx.getImageData(0,0,256,256); closeCamera(); await embedImageAndShow(orig); }
    $('wd-cam-shot').addEventListener('click', shootCamera);
    $('wd-cam-cancel').addEventListener('click', closeCamera);
    // ---------- shared ----------
    function sleep(ms){ return new Promise(function(r){setTimeout(r,ms)}); }
    async function ensureOrt(){ if(ort) return ort; ort=await import('https://cdn.jsdelivr.net/npm/onnxruntime-web@'+ORT+'/dist/ort.mjs'); ort.env.wasm.numThreads=1; ort.env.wasm.wasmPaths='https://cdn.jsdelivr.net/npm/onnxruntime-web@'+ORT+'/dist/'; return ort; }

    // ---------- tabs ----------
    document.querySelectorAll('.wd-tab').forEach(function(t){ t.addEventListener('click',function(){ var tab=t.getAttribute('data-tab'); document.querySelectorAll('.wd-tab').forEach(function(b){ var on=b.getAttribute('data-tab')===tab; b.classList.toggle('text-ink',on); b.classList.toggle('border-accent',on); b.classList.toggle('text-muted',!on); b.classList.toggle('border-transparent',!on); }); $('wd-panel-image').classList.toggle('hidden',tab!=='image'); $('wd-panel-audio').classList.toggle('hidden',tab!=='audio'); }); });

    // ---------- audio (AudioSeal) ----------
    var audioEmb=null, audioDet=null, aGallery=null, aCurrent=null, aBases={}, lastA=null, audioCtx=null, srcNode=null, SR=16000;
    async function decodeTo16k(ab){ var ac=new (window.AudioContext||window.webkitAudioContext)(); var buf=await ac.decodeAudioData(ab.slice(0)); ac.close(); var off=new OfflineAudioContext(1,Math.ceil(buf.duration*SR),SR); var mono=off.createBuffer(1,buf.length,buf.sampleRate); var m=mono.getChannelData(0); for(var ch=0;ch<buf.numberOfChannels;ch++){ var d=buf.getChannelData(ch); for(var i=0;i<d.length;i++) m[i]+=d[i]/buf.numberOfChannels; } var s=off.createBufferSource(); s.buffer=mono; s.connect(off.destination); s.start(); var r=await off.startRendering(); return r.getChannelData(0).slice(); }
    async function fetchAudio(url){ return decodeTo16k(await (await fetch(url)).arrayBuffer()); }
    function randMsg16(){ var bits=new Uint8Array(16),big=new BigInt64Array(16),r=new Uint8Array(16); crypto.getRandomValues(r); for(var i=0;i<16;i++){bits[i]=r[i]&1;big[i]=BigInt(bits[i]);} return {bits:bits,tensor:new ort.Tensor('int64',big,[1,16])}; }
    async function embedAudio(x,msgTensor){ var N=16000,out=new Float32Array(x.length); for(var o=0;o<x.length;o+=N){ var len=Math.min(N,x.length-o); var frame=new Float32Array(N); frame.set(x.subarray(o,o+len)); var t=new ort.Tensor('float32',frame,[1,1,N]); var r=await audioEmb.run({audio:t,message:msgTensor}); var w=r.audio_w.data; for(var i=0;i<len;i++) out[o+i]=w[i]; } return out; }
    function audioAttack(x){ var crop=+$('wa-crop').value,noise=+$('wa-noise').value,y=x; if(crop<100) y=y.slice(0,Math.floor(y.length*crop/100)); if(noise>0){ var s=noise/1000,z=new Float32Array(y.length); for(var i=0;i<y.length;i++) z[i]=y[i]+(Math.random()+Math.random()+Math.random()-1.5)*s; y=z; } return y; }
    function drawWave(x){ var c=$('wa-wave'),ctx=c.getContext('2d'),W=c.width,H=c.height; ctx.clearRect(0,0,W,H); ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--color-accent')||'#12507a'; ctx.beginPath(); var step=Math.max(1,Math.ceil(x.length/W)); for(var i=0;i<W;i++){ var mn=1,mx=-1; for(var j=0;j<step;j++){ var v=x[i*step+j]||0; if(v<mn)mn=v; if(v>mx)mx=v; } ctx.moveTo(i,(1-(mx*0.9+1)/2)*H); ctx.lineTo(i,(1-(mn*0.9+1)/2)*H); } ctx.stroke(); }
    function aStop(){ if(srcNode){ try{srcNode.stop()}catch(e){} srcNode=null; } }
    function aPlay(x){ if(!x) return; aStop(); audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)(); var b=audioCtx.createBuffer(1,x.length,SR); b.getChannelData(0).set(x); srcNode=audioCtx.createBufferSource(); srcNode.buffer=b; srcNode.connect(audioCtx.destination); srcNode.start(); }
    function aResetResult(){ $('wa-acc').textContent='--'; $('wa-accbar').style.width='0%'; var v=$('wa-verdict'); v.textContent='idle'; v.style.color=''; v.style.borderColor=''; $('wa-bitstring').textContent='press the Detect button to read the hidden bits'; }
    function applyAudioAttacks(){ if(!aBases.wm) return; lastA=audioAttack(aBases.wm); drawWave(lastA); aResetResult(); }
    async function aDetect(){ if(!audioDet||!lastA) return; var v=$('wa-verdict'); v.textContent='reading...'; var out=await audioDet.run({audio:new ort.Tensor('float32',lastA,[1,1,lastA.length])}); var msg=out.message.data,truth=aCurrent&&aCurrent.bits?aCurrent.bits:null,correct=0,html=''; for(var i=0;i<16;i++){ var bit=msg[i]>0.5?1:0; var ok=truth?bit===truth[i]:true; if(ok)correct++; var col=truth==null?'#94a3b8':(ok?'#34d399':'#f87171'); html+='<span style="color:'+col+'">'+bit+'</span>'; } $('wa-bitstring').innerHTML=html; var acc=$('wa-acc'),bar=$('wa-accbar'); acc.textContent=truth?String(correct):'?'; var pct=truth?correct/16:1; bar.style.width=(pct*100)+'%'; var label,c2; if(pct>=0.9){label='detected';c2='var(--color-accent)';}else if(pct>=0.66){label='degraded';c2='#c98a00';}else{label='destroyed';c2='#d1495b';} bar.style.background=c2; v.textContent=label+' ('+Math.round(pct*100)+'%)'; v.style.color=c2; v.style.borderColor=c2; }
    async function aSelect(clip){ aStop(); aCurrent={id:clip.id,bits:clip.bits?Uint8Array.from(clip.bits,function(c){return +c}):null}; aBases.orig=await fetchAudio(cfg.audDir+clip.orig); aBases.wm=await fetchAudio(cfg.audDir+clip.wm); $('wa-noise').value=0; $('wa-vn').textContent='0'; $('wa-crop').value=100; $('wa-vc').textContent='100'; applyAudioAttacks(); document.querySelectorAll('#wa-gallery .wa-th').forEach(function(t){t.classList.toggle('ring-2',t.dataset.id===clip.id);}); }
    async function aWatermarkOwn(x){ var o=$('wa-overlay'); o.classList.remove('hidden'); $('wa-ovl-msg').textContent='Watermarking your audio in your browser...'; $('wa-ovl-bar').style.width='30%'; await sleep(30); var m=randMsg16(); aBases.orig=x; aBases.wm=await embedAudio(x,m.tensor); $('wa-ovl-bar').style.width='100%'; aCurrent={id:'you',bits:m.bits}; document.querySelectorAll('#wa-gallery .wa-th').forEach(function(t){t.classList.remove('ring-2');}); $('wa-noise').value=0; $('wa-vn').textContent='0'; $('wa-crop').value=100; $('wa-vc').textContent='100'; applyAudioAttacks(); o.classList.add('hidden'); }
    async function aLoad(){ $('wa-load').disabled=true; $('wa-load').style.opacity=.5; $('wa-load-progress').classList.remove('hidden'); var msg=$('wa-load-msg'),bar=$('wa-load-bar'); try{ msg.textContent='fetching ONNX Runtime...'; await ensureOrt(); var eb=await fetchModel(cfg.audEmbedder,30000000,bar,msg,'downloading generator...'); try{audioEmb=await ort.InferenceSession.create(eb,{executionProviders:['webgpu','wasm']});}catch(e){audioEmb=await ort.InferenceSession.create(eb,{executionProviders:['wasm']});} var db=await fetchModel(cfg.audDetector,17427927,bar,msg,'downloading detector...'); try{audioDet=await ort.InferenceSession.create(db,{executionProviders:['webgpu','wasm']});}catch(e){audioDet=await ort.InferenceSession.create(db,{executionProviders:['wasm']});} $('wa-loader').classList.add('hidden'); $('wa-demo').classList.remove('hidden'); aGallery=await (await fetch(cfg.audGallery)).json(); var g=$('wa-gallery'); aGallery.clips.forEach(function(clip){ var b=document.createElement('button'); b.className='wa-th px-3 py-1.5 rounded-md border border-border font-mono text-[12px] text-ink-soft ring-accent hover:ring-2'; b.dataset.id=clip.id; b.textContent='music '+clip.id; b.addEventListener('click',function(){aSelect(clip)}); g.appendChild(b); }); var up=document.createElement('button'); up.className='px-3 py-1.5 rounded-md border border-dashed border-accent/60 text-accent font-mono text-[12px] hover:bg-accent-soft transition-colors'; up.textContent='+ upload'; up.addEventListener('click',function(){$('wa-upload').click();}); g.appendChild(up); var mic=document.createElement('button'); mic.className='px-3 py-1.5 rounded-md border border-dashed border-accent/60 text-accent font-mono text-[12px] hover:bg-accent-soft transition-colors'; mic.textContent='record mic'; mic.addEventListener('click',openMic); g.appendChild(mic); await aSelect(aGallery.clips[0]); }catch(e){ msg.textContent='failed: '+(e&&e.message?e.message:e); $('wa-load').disabled=false; $('wa-load').style.opacity=1; } }
    var aUp=document.createElement('input'); aUp.type='file'; aUp.accept='audio/*'; aUp.id='wa-upload'; aUp.className='hidden'; document.body.appendChild(aUp);
    aUp.addEventListener('change',async function(e){ var f=e.target.files[0]; if(!f) return; try{ var x=await decodeTo16k(await f.arrayBuffer()); await aWatermarkOwn(x); }catch(err){ $('wa-ovl-msg').textContent='Failed: '+(err&&err.message?err.message:err); } });
    var micRec=null,micChunks=[];
    async function openMic(){ try{ var stream=await navigator.mediaDevices.getUserMedia({audio:true}); micChunks=[]; micRec=new MediaRecorder(stream); micRec.ondataavailable=function(e){ if(e.data.size) micChunks.push(e.data); }; micRec.onstop=async function(){ stream.getTracks().forEach(function(t){t.stop()}); $('wa-mic').classList.add('hidden'); try{ var blob=new Blob(micChunks,{type:micRec.mimeType||'audio/webm'}); var x=await decodeTo16k(await blob.arrayBuffer()); await aWatermarkOwn(x); }catch(err){ $('wa-ovl-msg').textContent='Failed: '+err.message; } }; micRec.start(); $('wa-mic').classList.remove('hidden'); }catch(e){ alert('Microphone unavailable: '+e.message); } }
    function stopMic(){ if(micRec&&micRec.state!=='inactive') micRec.stop(); }
    $('wa-load').addEventListener('click', aLoad);
    $('wa-detect').addEventListener('click', aDetect);
    $('wa-mic-stop').addEventListener('click', stopMic);
    $('wa-play-orig').addEventListener('click',function(){aPlay(aBases.orig);});
    $('wa-play-wm').addEventListener('click',function(){aPlay(lastA||aBases.wm);});
    $('wa-stop').addEventListener('click', aStop);
    $('wa-noise').addEventListener('input',function(){$('wa-vn').textContent=$('wa-noise').value;}); $('wa-noise').addEventListener('change',applyAudioAttacks);
    $('wa-crop').addEventListener('input',function(){$('wa-vc').textContent=$('wa-crop').value;}); $('wa-crop').addEventListener('change',applyAudioAttacks);
  })();
</script>
