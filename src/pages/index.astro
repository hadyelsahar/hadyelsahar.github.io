---
// Homepage: classic academic layout.
// Header → Selected projects (carousel) → Research journey (2014→now, with figures + selected papers) → Writing.

import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import LinkChip from '../components/LinkChip.astro';
import { withBase } from '../lib/url.ts';
import { papers } from '../data/papers.ts';
import { projects } from '../data/projects.ts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const paperById = Object.fromEntries(papers.map((p) => [p.id, p]));
const eraPapers: Record<string, string[]> = {
  phd: ['paper-qg-kg', 'paper-wikidata'],
  naver: ['paper-gdc', 'paper-cdpg', 'paper-dpg', 'paper-discrete-ebm', 'paper-ebm-code', 'paper-opinion-summ', 'paper-aspect-summ', 'paper-domain-shift'],
  seamless: ['paper-seamless', 'paper-nature-100lang'],
  contentseal: ['paper-text-seal', 'paper-pixel-seal', 'paper-chunky-seal', 'paper-video-seal', 'paper-audio-seal'],
};
const papersFor = (key: string) => (eraPapers[key] ?? []).map((id) => paperById[id]).filter(Boolean);

const contactLinks = [
  { label: 'Email', href: 'mailto:hadyelsahar@gmail.com' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?hl=en&user=SbcM6bsAAAAJ' },
  { label: 'GitHub', href: 'https://github.com/hadyelsahar' },
  { label: 'Twitter / X', href: 'https://twitter.com/hadyelsahar' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hadyelsahar/' },
  { label: 'Hugging Face', href: 'https://huggingface.co/hadyelsahar' },
];
---

<BaseLayout title="Hady Elsahar" description="Hady Elsahar, Staff Research Scientist at FAIR, Meta Superintelligence Labs. Generative AI and safety: invisible watermarking, content provenance, multilingual & multimodal generation.">

  <!-- ============================================================ HEADER -->
  <section class="mx-auto max-w-[900px] px-6 pt-12 md:pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_212px] gap-x-10 gap-y-8 items-start">

      <!-- LEFT: name + bio -->
      <div>
        <h1 class="font-display text-[40px] md:text-[58px] font-semibold tracking-[-0.02em] leading-[0.95] text-ink">Hady Elsahar</h1>
        <p class="mt-4 text-[17px] leading-[1.5] text-ink-soft">
          Staff Research Scientist at <a href="https://ai.meta.com/" target="_blank" rel="noopener" class="link font-medium">FAIR, Meta Superintelligence Labs</a>, on the
          <a href="https://facebookresearch.github.io/content-seal/" target="_blank" rel="noopener" class="link font-medium">Content Seal</a> team.
          I work at the intersection of <span class="font-medium">generative AI and safety</span>, currently on invisible watermarking
          and content provenance, helping scale watermarking and AI-generated-media detection to billions of users,
          watermarking millions of videos a day.
        </p>

        <div class="mt-6 space-y-4 text-[14.5px] leading-[1.7] text-ink-soft">
          <p>
            I've worked across generative AI since 2014, back when we still derived our gradients by hand
            and coded the backward pass line by line, training stacked LSTMs and GRUs before autodiff
            frameworks like PyTorch and TensorFlow existed. Since then I've had a front-row seat to the
            field's evolution: the copy and attention mechanisms we built when out-of-vocabulary tokens
            were still a plague (before byte-pair encoding), controllable and multilingual generation, and
            today's questions of what's real in the era of deepfakes.
          </p>
          <p>
            Before Meta I was a research scientist at <a href="https://europe.naverlabs.com/" target="_blank" rel="noopener" class="link font-medium">Naver Labs Europe</a>,
            where I worked with Marc Dymetman on reinforcement-learning algorithms for fine-tuning language
            models <span class="font-medium text-ink">without catastrophic forgetting</span>: control formalized as
            constraint satisfaction over distributions, solved with Energy-Based Models and distributional policy
            gradients. It was core research in what would become the RLHF field, a few years before PPO, DPO,
            and GRPO became standard practice, published at NeurIPS, ICML, ICLR (2021 Oral, top 2.1%), TMLR, and ACL.
            Earlier I worked at <span class="font-medium text-ink">Bloomberg</span>, IBM, and Microsoft on NLP, and
            did my Ph.D. at Université de Lyon with <a href="https://twitter.com/chgravier" target="_blank" rel="noopener" class="link">Christophe Gravier</a>
            and Frédérique Laforest on generating natural language from knowledge graphs: zero-shot question
            generation and multilingual Wikipedia summaries from Wikidata.
          </p>
          <p>
            Beyond research, I was a board member of <a href="https://www.masakhane.io/" target="_blank" rel="noopener" class="link font-medium">Masakhane</a>, whose
            participatory-research paper received the <a href="https://research.wikimedia.org/awards.html" target="_blank" rel="noopener" class="link">Wikimedia Foundation Research Award</a>,
            and I helped organize <a href="https://africanlp.github.io/" target="_blank" rel="noopener" class="link font-medium">AfricaNLP</a>. I care about making AI work for under-represented
            languages and communities. I grew up in Cairo, a city full of stories.
          </p>
        </div>

        <p class="mt-6 text-[13px] leading-[1.6] text-muted border-l-2 border-accent/50 pl-4">
          <span class="font-medium text-ink-soft">No borders, free identities.</span> We treat borders as
          physical realities and identities as fixed labels. I see them differently: borders are constructs
          we choose to believe in, and identity is a <a class="link" href="https://en.wikipedia.org/wiki/Ship_of_Theseus" id="theseus-link" data-theseus-open>Ship of Theseus</a>.
        </p>
      </div>

      <!-- RIGHT: sticky sidebar -->
      <aside class="md:sticky md:top-[72px] self-start">
        <img
          src={withBase('/assets/profile.jpg')}
          alt="Hady Elsahar"
          width="212" height="254"
          class="w-[132px] md:w-full aspect-[5/6] object-cover rounded-[8px] border border-border"
        />

        <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Elsewhere</p>
        <ul class="mt-2 grid grid-cols-2 md:grid-cols-1 gap-x-4 gap-y-1.5 text-[13px]">
          {contactLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-accent hover:text-accent-strong">
                {l.label}<span aria-hidden="true" class="text-muted-2">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Languages</p>
        <ul class="mt-2 space-y-1 text-[11.5px] leading-[1.5] text-muted">
          <li dir="rtl" lang="ar">العربية هي لغتي الأم.</li>
          <li lang="en">I speak English at a near-native level.</li>
          <li lang="fr">Je parle français à un niveau intermédiaire avancé.</li>
          <li lang="de">Ich spreche Deutsch auf mittlerem Niveau.</li>
          <li lang="ko">저는 한국어를 초급 수준으로 구사합니다.</li>
        </ul>
      </aside>

    </div>
  </section>

  <!-- ============================================================ SELECTED PROJECTS -->
  <section id="projects" class="reveal mx-auto max-w-[900px] px-6 py-12 border-t border-border">
    <div class="flex items-end justify-between gap-6 mb-6 pb-2 border-b border-border">
      <h2 class="font-display text-[15px] font-semibold tracking-tight text-ink">Selected projects</h2>
      <div class="flex items-center gap-2">
        <button data-proj-scroll="-1" aria-label="Previous project" class="h-8 w-8 rounded-full border border-border text-muted hover:text-ink hover:border-ink transition-colors leading-none">←</button>
        <button data-proj-scroll="1" aria-label="Next project" class="h-8 w-8 rounded-full border border-border text-muted hover:text-ink hover:border-ink transition-colors leading-none">→</button>
      </div>
    </div>

    <div id="proj-track" class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-6 px-6" style="scrollbar-width:none;">
      {projects.map((p) => (
        <article class="snap-start shrink-0 w-[300px] sm:w-[440px] border border-border rounded-[10px] overflow-hidden bg-card flex flex-col">
          <div class:list={["aspect-[16/9] border-b border-border overflow-hidden", p.imageContain ? "bg-bg-subtle flex items-center justify-center p-3" : "bg-bg-subtle"]}>
            <img src={withBase(p.image)} alt={p.title} loading="lazy" class:list={[p.imageContain ? "max-h-full w-auto object-contain" : "w-full h-full object-cover", p.imagePos]} />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent">{p.period}</p>
            <h3 class="mt-1 font-serif text-[19px] font-semibold text-ink leading-tight">{p.title}</h3>
            <p class="mt-2 text-[13px] leading-[1.55] text-ink-soft" set:html={p.blurb}></p>

            {p.gallery && p.gallery.length > 0 && (
              <div class="mt-4 flex gap-2">
                {p.gallery.map((g) => (
                  <a href={g.href} target="_blank" rel="noopener" class="group/g block flex-1 min-w-0" title={g.alt}>
                    <div class="aspect-[16/10] rounded-[5px] border border-border overflow-hidden bg-bg-subtle">
                      <img src={withBase(g.img)} alt={g.alt} loading="lazy" class:list={["w-full h-full object-cover group-hover/g:opacity-90 transition-opacity", g.pos]} />
                    </div>
                  </a>
                ))}
              </div>
            )}

            {p.press.length > 0 && (
              <>
                <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.15em] text-muted">Press &amp; recognition</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {p.press.map((l) => (
                    <LinkChip label={l.label} href={l.href} />
                  ))}
                </div>
              </>
            )}

            {p.links.length > 0 && (
              <>
                <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.15em] text-muted">Links</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {p.links.map((l) => (
                    <LinkChip label={l.label} href={l.href} />
                  ))}
                </div>
              </>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var track = document.getElementById('proj-track');
      if (!track) return;
      var card = track.querySelector('article');
      var step = card ? card.offsetWidth + 20 : 380;
      document.querySelectorAll('[data-proj-scroll]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          track.scrollBy({ left: Number(btn.getAttribute('data-proj-scroll')) * step, behavior: 'smooth' });
        });
      });
    })();
  </script>

  <!-- ============================================================ RESEARCH JOURNEY -->
  <section id="research" class="reveal mx-auto max-w-[900px] px-6 py-12 border-t border-border">
    <div class="flex items-baseline justify-between gap-6 mb-6 pb-2 border-b border-border">
      <h2 class="font-serif text-[15px] font-semibold tracking-tight text-ink">Research journey</h2>
      <button
        id="journey-flip"
        type="button"
        aria-pressed="false"
        aria-label="Reverse the timeline order"
        class="group font-mono text-[10px] tracking-widest text-muted-2 uppercase inline-flex items-center gap-1.5 hover:text-accent transition-colors"
      >
        <span data-journey-label>2014 → today</span>
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:rotate-180">⇅</span>
      </button>
    </div>

    <p class="mb-10 text-[13px] text-muted">
      Full, always-current publication list on
      <a class="link" href="https://scholar.google.com/citations?hl=en&user=SbcM6bsAAAAJ">Google Scholar</a> and
      <a class="link" href="https://dblp.uni-trier.de/pers/hd/e/ElSahar:Hady">DBLP</a>.
    </p>

    <div id="journey" class="space-y-12">

      <!-- PhD -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2014 – 2018</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Ph.D., Université de Lyon</p>
          <p class="mt-2 font-mono text-[10.5px] leading-[1.6] text-muted-2">data-to-text · relation extraction · copy actions · KB embeddings (TransE) · zero-shot generation</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Knowledge-grounded generation &amp; copy mechanisms</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            My thesis addressed data-to-text generation and relation extraction, in the pre-Transformer era
            when models were still small enough to reason about by hand. I worked on
            <span class="font-medium text-ink">out-of-vocabulary tokens and copy actions</span> (early attention
            and pointer mechanisms, from a time when named entities were a plague before byte-pair encoding),
            and on conditioning recurrent language models (stacked LSTMs / GRUs) on
            <span class="font-medium text-ink">retrieved knowledge-base facts</span> via early KB embeddings
            (TransE): in retrospect, a precursor to retrieval-augmented generation (RAG). Attention of this kind
            is what self-attention would soon scale into the default way the world trains language models.
          </p>
          <figure class="mt-5">
            <img src={withBase('/assets/figures/fig-qg-kg.png')} alt="Zero-shot question generation model with a fact encoder, textual context encoders, and a copy-action GRU decoder using GloVe and TransE embeddings" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
            <figcaption class="mt-2 text-[12px] text-muted">
              A GRU decoder with part-of-speech copy actions, conditioned on knowledge-base facts (TransE) and textual context.
              From <em>Zero-Shot Question Generation from Knowledge Graphs</em> (NAACL 2018).
            </figcaption>
          </figure>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('phd').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Bloomberg -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2018</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Bloomberg, London</p>
          <p class="mt-2 font-mono text-[10.5px] leading-[1.6] text-muted-2">multi-document summarization · faithfulness · production NLP</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Neural abstractive summarization in production</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            I spent a year extending my summarization research into a
            <span class="font-medium text-ink"> summarization engine now deployed at scale in the Bloomberg
            Terminal</span>, an early lesson in taking neural generation from paper to product.
          </p>
          <figure class="mt-5">
            <a href="https://www.youtube.com/watch?v=2he8Jgmjo9M" target="_blank" rel="noopener" class="group relative block overflow-hidden rounded-[6px] border border-border bg-figure">
              <img src={withBase('/assets/figures/bloomberg-nstm.jpg')} alt="Bloomberg Terminal NSTM (Key News Themes) output, grouping news into summarized themes" loading="lazy" class="w-full transition-transform duration-300 group-hover:scale-[1.02]" />
              <span class="pointer-events-none absolute inset-0 grid place-items-center">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-black/55 text-white text-[17px] pl-1 backdrop-blur-sm transition-colors group-hover:bg-accent">▶</span>
              </span>
            </a>
            <figcaption class="mt-2 text-[12px] text-muted">
              Bloomberg Terminal, NSTM (Key News Themes). The summarization engine ships under <span class="font-mono text-[11px] text-ink-soft">NSTM &lt;GO&gt;</span>. Click to watch the demo.
            </figcaption>
          </figure>
        </div>
      </article>

      <!-- Naver -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2019 – 2022</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Naver Labs Europe</p>
          <p class="mt-2 font-mono text-[10.5px] leading-[1.6] text-muted-2">energy-based models · distributional policy gradients · KL control · catastrophic forgetting · controlled summarization</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Controllable generation, EBMs &amp; distributional RL</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            With Marc Dymetman, I studied fine-tuning language models under reinforcement learning while
            <span class="font-medium text-ink"> avoiding catastrophic forgetting</span>, years before RLHF and
            PPO fine-tuning became shorthand.
            shorthand. We formalized control as constraint satisfaction over distributions, solved via
            Energy-Based Models and distributional policy gradients, an ICLR 2021 Oral (top 2.1%) and its
            conditional extension at ICML 2022.
          </p>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
            <figure>
              <img src={withBase('/assets/figures/fig-gdc.png')} alt="Information-geometry diagram: projecting from a Maximum-Entropy specification to an Energy-Based Model" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
              <figcaption class="mt-2 text-[12px] text-muted">Distributional control via Information Geometry · <em>A Distributional Approach to Controlled Text Generation</em> (ICLR 2021, Oral).</figcaption>
            </figure>
            <figure>
              <img src={withBase('/assets/figures/fig-cdpg.png')} alt="Training curves showing Reinforce collapsing in BLEU-4 while CDPG maintains quality" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
              <figcaption class="mt-2 text-[12px] text-muted">Standard RL (Reinforce) catastrophically loses quality; CDPG satisfies the constraint while preserving it · <em>ICML 2022</em>.</figcaption>
            </figure>
          </div>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('naver').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Meta Seamless -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2022 – 2024</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Meta FAIR · Seamless</p>
          <p class="mt-2 font-mono text-[10.5px] leading-[1.6] text-muted-2">speech-to-speech · speech-to-text · ~100 languages · self-supervised speech representations</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Massively multilingual &amp; multimodal translation</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            I joined the Seamless effort and helped build <span class="font-medium text-ink">SeamlessM4T</span>,
            a single foundation model for direct speech-to-speech and speech-to-text translation across close to
            100 languages. It was named one of
            <a class="link" href="https://time.com/collection/best-inventions-2023/6326994/meta-seamlessm4t/">Time's Best Inventions of 2023</a>,
            and published in <a class="link" href="https://www.nature.com/articles/s41586-024-08359-z">Nature (2025)</a>.
          </p>
          <div class="mt-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">SeamlessExpressive · translation that keeps your emotion and tone</p>
            <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3">
              {[
                { v: 'excited', label: 'Excited', lang: '→ German' },
                { v: 'fast-talking', label: 'Fast talking', lang: '→ French' },
                { v: 'sad', label: 'Sad', lang: '→ Spanish' },
                { v: 'whispering', label: 'Whispering', lang: '→ English' },
              ].map((d) => (
                <figure>
                  <video class="w-full aspect-square object-cover rounded-[6px] border border-border bg-figure" controls preload="none" playsinline poster={withBase(`/assets/demos/seamless/${d.v}.png`)}>
                    <source src={withBase(`/assets/demos/seamless/${d.v}.mp4`)} type="video/mp4" />
                  </video>
                  <figcaption class="mt-1.5 text-center font-mono text-[10.5px] text-muted">{d.label} <span class="text-muted-2">{d.lang}</span></figcaption>
                </figure>
              ))}
            </div>
            <p class="mt-3 text-[12px] text-muted">Clips from the <a class="link" href="https://seamless.metademolab.com/expressive">SeamlessExpressive</a> demo.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('seamless').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Content Seal -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2024 – now</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Meta FAIR · Content Seal</p>
          <p class="mt-2 font-mono text-[10.5px] leading-[1.6] text-muted-2">localized watermarking · robustness to editing/compression · multi-modal (image · video · audio · text) · AIGC detection</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Invisible watermarking &amp; content provenance</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            As voice cloning and strong image/video generators emerged, content provenance and AI-generated-media
            detection became urgent. I helped build the <span class="font-medium text-ink">Content Seal</span> team
            and its unified invisible-watermarking framework across image, video, audio, and text, starting with
            <span class="font-medium text-ink"> AudioSeal</span> (ICML 2024) and <span class="font-medium text-ink">Video Seal</span>.
            Content Seal now watermarks content from Meta's Muse Image/Video and powers
            <a class="link" href="https://meta.ai/identification">meta.ai/identification</a>, running across the
            family of apps to watermark and detect AI-generated media at massive scale. I also organized the
            <a class="link" href="https://huggingface.co/blog/hadyelsahar/watermarking-iclr2025">Watermarking Workshop at ICLR 2025</a>.
          </p>
          <figure class="mt-6">
            <div
              class="group relative w-full cursor-pointer overflow-hidden rounded-[8px] border border-border bg-figure"
              style="aspect-ratio: 16 / 9;"
              data-video-facade
              data-src={withBase('/assets/demos/contentseal-banner.mp4')}
              role="button"
              tabindex="0"
              aria-label="Play the Video Seal demo film"
            >
              <img src={withBase('/assets/demos/contentseal-banner.jpg')} alt="Video Seal: invisible video watermarking demo" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
              <span class="pointer-events-none absolute inset-0 grid place-items-center">
                <span class="grid h-16 w-16 place-items-center rounded-full bg-black/55 text-white text-[20px] pl-1 backdrop-blur-sm transition-colors group-hover:bg-accent">▶</span>
              </span>
            </div>
            <figcaption class="mt-2 text-[12px] text-muted">
              <span class="font-medium text-ink-soft">Video Seal</span>: invisible watermarks that survive re-encoding, cropping, and edits. Header film from the <a class="link" href="https://facebookresearch.github.io/content-seal/">Content Seal</a> site. <a class="link" href="https://aidemos.meta.com/videoseal">Try the live demo</a>.
            </figcaption>
          </p>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('contentseal').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- ============================================================ WRITING -->
  {latestPosts.length > 0 && (
    <section class="reveal mx-auto max-w-[900px] px-6 py-12 border-t border-border">
      <Eyebrow label="Recent writing" kicker="Essays" />
      <ul class="space-y-1">
        {latestPosts.map((post) => (
          <li>
            <a href={withBase(`/posts/${post.id}/`)} class="group grid grid-cols-1 sm:grid-cols-[90px_1fr] gap-x-5 gap-y-1 py-3 border-b border-border/70">
              <span class="font-mono text-[11px] text-muted pt-0.5">{fmtDate(post.data.pubDate)}</span>
              <div>
                <h3 class="text-[15.5px] font-semibold text-ink group-hover:text-accent transition-colors">{post.data.title}</h3>
                {post.data.description && (
                  <p class="mt-1 text-[13.5px] leading-[1.55] text-muted">{post.data.description}</p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/posts/')} class="mt-4 inline-flex text-[13px] text-accent hover:text-accent-strong underline decoration-border-strong underline-offset-2">All posts →</a>
    </section>
  )}
  <script is:inline>
    (function () {
      document.querySelectorAll('[data-video-facade]').forEach(function (el) {
        function play() {
          var src = el.getAttribute('data-src');
          if (!src || el.dataset.loaded) return;
          el.dataset.loaded = '1';
          el.innerHTML = '<video class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline controls preload="auto"><source src="' + src + '" type="video/mp4"></video>';
          el.classList.remove('cursor-pointer');
          el.removeAttribute('role');
          el.removeAttribute('tabindex');
        }
        el.addEventListener('click', play);
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); }
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var btn = document.getElementById('journey-flip');
      var list = document.getElementById('journey');
      if (!btn || !list) return;
      var label = btn.querySelector('[data-journey-label]');
      var reversed = false;
      btn.addEventListener('click', function () {
        Array.prototype.slice.call(list.children).reverse().forEach(function (el) { list.appendChild(el); });
        reversed = !reversed;
        if (label) label.textContent = reversed ? 'Today → 2014' : '2014 → today';
        btn.setAttribute('aria-pressed', reversed ? 'true' : 'false');
      });
    })();
  </script>

  <!-- ==================================================== SHIP OF THESEUS -->
  <div id="theseus-modal" class="sot-overlay" hidden>
    <div class="sot-card" role="dialog" aria-modal="true" aria-label="Ship of Theseus" tabindex="-1">
      <button type="button" class="sot-close" data-theseus-close aria-label="Close">&times;</button>

      <p class="sot-verdict"><span id="sot-state">the old ship</span></p>

      <div class="sot-scene" id="sot-scene">
        <svg class="sot-ship" viewBox="0 0 480 360" role="img" aria-labelledby="sot-svg-title" preserveAspectRatio="xMidYMid meet">
          <title id="sot-svg-title">A sailboat whose planks are replaced one by one as the light turns from dawn to dusk</title>
          <defs>
            <clipPath id="sot-clip"><rect x="0" y="0" width="480" height="360" rx="14" /></clipPath>
            <linearGradient id="sot-sky-old" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4c606e" /><stop offset="0.6" stop-color="#8296a0" /><stop offset="1" stop-color="#aebdc4" />
            </linearGradient>
            <linearGradient id="sot-sky-new" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3d5170" /><stop offset="0.45" stop-color="#c9713f" /><stop offset="1" stop-color="#f2c777" />
            </linearGradient>
            <radialGradient id="sot-sun" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#fff6e2" /><stop offset="0.55" stop-color="var(--sun-core)" /><stop offset="1" stop-color="var(--sun-core)" stop-opacity="0" />
            </radialGradient>
            <filter id="sot-ink" x="-8%" y="-8%" width="116%" height="116%">
              <feTurbulence type="fractalNoise" baseFrequency="0.013" numOctaves="2" seed="7" result="noise" />
              <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <filter id="sot-soft"><feGaussianBlur stdDeviation="1.6" /></filter>
          </defs>

          <g clip-path="url(#sot-clip)">
            <!-- sky: cold dawn cross-fading to warm dusk -->
            <rect x="0" y="0" width="480" height="360" fill="url(#sot-sky-old)" />
            <rect id="sot-sky" x="0" y="0" width="480" height="360" fill="url(#sot-sky-new)" opacity="0" />
            <!-- sun / moon -->
            <circle id="sot-sun" cx="120" cy="230" r="34" fill="url(#sot-sun)" />

            <!-- water -->
            <rect x="0" y="248" width="480" height="112" fill="#000" opacity="0.16" />

            <!-- reflection of the ship, flipped under the waterline -->
            <use href="#sot-ship-body" transform="matrix(1 0 0 -1 0 496)" class="sot-reflection" filter="url(#sot-soft)" />

            <!-- rolling waves over the reflection -->
            <g class="sot-sea" aria-hidden="true">
              <path d="M-40 268 q42 -12 84 0 t84 0 t84 0 t84 0 t84 0 t84 0" />
              <path d="M-60 292 q46 -11 92 0 t92 0 t92 0 t92 0 t92 0" />
              <path d="M-30 314 q40 -9 80 0 t80 0 t80 0 t80 0 t80 0 t80 0" />
            </g>

            <!-- the ship -->
            <g id="sot-ship-body" class="sot-drawing" filter="url(#sot-ink)">
              <line class="sot-spar" x1="234" y1="196" x2="234" y2="40" />
              <line class="sot-spar" x1="234" y1="46" x2="342" y2="82" />
              <line class="sot-spar" x1="234" y1="192" x2="352" y2="150" />

              <path id="sot-sail" class="sot-sail" d="M234 54 L336 84 Q356 118 346 150 L234 190 Q232 120 234 54 Z" />

              <g class="sot-hull">
                <path class="sot-part" data-i="0" d="M60 190 Q240 214 420 190 Q240 236 60 190 Z" />
                <path class="sot-part" data-i="1" d="M60 190 Q240 236 420 190 Q240 258 60 190 Z" />
                <path class="sot-part" data-i="2" d="M60 190 Q240 258 420 190 Q240 280 60 190 Z" />
                <path class="sot-part" data-i="3" d="M60 190 Q240 280 420 190 Q240 300 60 190 Z" />
              </g>
              <path class="sot-part sot-deck" data-i="4" d="M60 190 Q240 206 420 190 Q240 176 60 190 Z" />
              <g class="sot-deck-lines">
                <path d="M150 189 q0 8 3 14" /><path d="M225 191 q0 9 2 15" /><path d="M300 189 q0 8 -3 14" />
              </g>
              <path class="sot-stem" d="M60 190 Q46 166 68 148" />
              <path class="sot-stem" d="M420 190 Q434 166 412 148" />
            </g>
          </g>
        </svg>
        <div class="sot-sparks" id="sot-sparks" aria-hidden="true"></div>
        <div class="sot-drag-hint" id="sot-hint">drag to sail through the years →</div>
      </div>

      <input type="range" id="sot-scrub" class="sot-scrub" min="0" max="100" value="0" step="1"
             aria-label="Replace the ship's timbers over time" />
    </div>
  </div>

  <style is:global>
    .sot-overlay {
      position: fixed; inset: 0; z-index: 200; display: grid; place-items: center;
      padding: clamp(12px, 4vw, 32px);
      background: color-mix(in srgb, #05080c 72%, transparent);
      backdrop-filter: blur(6px); opacity: 0; transition: opacity .3s ease;
    }
    .sot-overlay[hidden] { display: none; }
    .sot-overlay.is-open { opacity: 1; }

    .sot-card {
      --wood-old: #6b6053; --wood-new: #b0722c;
      --deck-old: #786c5c; --deck-new: #c98a45;
      --sail-old: #c3beb4; --sail-new: #f6f4ee;
      --sun-core: #cddbe2;
      position: relative; width: min(600px, 100%); max-height: 94vh; overflow: hidden;
      background: var(--color-card); color: var(--color-ink);
      border: 1px solid var(--color-border); border-radius: 18px;
      box-shadow: 0 34px 90px -24px rgba(0,0,0,.6);
      padding: clamp(24px, 4vw, 40px) clamp(22px, 4vw, 44px) clamp(28px, 4vw, 40px);
      transform: translateY(14px) scale(.98);
      transition: transform .3s cubic-bezier(.22,1,.36,1);
    }
    .sot-overlay.is-open .sot-card { transform: none; }
    html.dark .sot-card { --wood-old: #7f7364; --sail-old: #9c978d; }

    .sot-close {
      position: absolute; top: 12px; right: 14px; width: 32px; height: 32px; border-radius: 999px;
      border: 0; background: transparent; color: var(--color-muted-2); z-index: 3;
      font-size: 22px; line-height: 1; cursor: pointer; transition: color .15s;
    }
    .sot-close:hover { color: var(--color-ink); }

    /* the one morphing line */
    .sot-verdict { text-align: center; margin: 0 0 14px; min-height: 1.4em; }
    .sot-verdict span {
      display: inline-block; font-family: var(--font-display); font-style: italic; font-weight: 500;
      font-size: clamp(22px, 4.4vw, 34px); letter-spacing: -.01em; color: var(--color-ink-soft);
      transition: color .5s ease, opacity .25s ease, transform .25s ease;
    }
    .sot-verdict.is-swap span { opacity: 0; transform: translateY(-6px); }
    .sot-verdict.is-wavering span { color: var(--color-accent); }

    /* scene */
    .sot-scene {
      position: relative; width: 100%; max-width: 480px; margin: 0 auto 18px;
      border-radius: 14px; overflow: hidden; cursor: ew-resize;
      box-shadow: inset 0 0 0 1px var(--color-border), 0 12px 30px -14px rgba(0,0,0,.5);
    }
    /* subtle top light + bottom vignette for depth */
    .sot-scene::after {
      content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: 14px;
      background: radial-gradient(120% 80% at 50% -10%, rgba(255,255,255,.18), transparent 55%),
                  radial-gradient(140% 60% at 50% 120%, rgba(0,0,0,.28), transparent 60%);
    }
    .sot-ship { display: block; width: 100%; height: auto; }
    .sot-drawing { fill: none; stroke: #211d18; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .sot-reflection { opacity: .16; }
    .sot-sea path { fill: none; stroke: rgba(255,255,255,.5); stroke-width: 1.6; stroke-linecap: round; opacity: .5; }
    .sot-part { fill: var(--wood-old); transition: fill .55s cubic-bezier(.22,1,.36,1); }
    .sot-part.is-new { fill: var(--wood-new); }
    .sot-deck { fill: var(--deck-old); }
    .sot-deck.is-new { fill: var(--deck-new); }
    .sot-deck-lines path { stroke-width: 1.4; opacity: .45; }
    .sot-sail { fill: var(--sail-old); transition: fill .2s linear; }
    .sot-spar { stroke: #3c2f1e; stroke-width: 3; }
    .sot-stem { stroke-width: 2.4; }

    @media (prefers-reduced-motion: no-preference) {
      .sot-drawing { animation: sot-bob 5.5s ease-in-out infinite; transform-origin: 240px 210px; }
      @keyframes sot-bob { 0%,100% { transform: rotate(-1deg) translateY(0); } 50% { transform: rotate(1deg) translateY(-3px); } }
      .sot-sea { animation: sot-drift 7s ease-in-out infinite; }
      @keyframes sot-drift { 0%,100% { transform: translateX(0); } 50% { transform: translateX(18px); } }
    }

    /* sawdust / ember sparks when a plank renews */
    .sot-sparks { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .sot-spark {
      position: absolute; width: 4px; height: 4px; border-radius: 999px;
      background: #f4d38a; box-shadow: 0 0 6px 1px rgba(244,211,138,.8);
      animation: sot-rise 1.1s ease-out forwards;
    }
    @keyframes sot-rise {
      0% { opacity: 0; transform: translateY(0) scale(.6); }
      15% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-46px) translateX(var(--dx,0)) scale(1); }
    }

    .sot-drag-hint {
      position: absolute; left: 0; right: 0; bottom: 10px; text-align: center;
      font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.82); text-shadow: 0 1px 3px rgba(0,0,0,.5);
      pointer-events: none; transition: opacity .4s ease;
    }
    .sot-scene.is-touched .sot-drag-hint { opacity: 0; }

    /* slider */
    .sot-scrub { -webkit-appearance: none; appearance: none; display: block; width: min(340px, 90%); margin: 0 auto; height: 8px; background: transparent; cursor: pointer; }
    .sot-scrub::-webkit-slider-runnable-track { height: 5px; border-radius: 999px; background: linear-gradient(90deg, var(--wood-old), var(--wood-new)); }
    .sot-scrub::-moz-range-track { height: 5px; border-radius: 999px; background: linear-gradient(90deg, var(--wood-old), var(--wood-new)); }
    .sot-scrub::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none; margin-top: -6px; width: 16px; height: 16px; border-radius: 999px;
      background: var(--color-card); border: 2px solid var(--color-ink); box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .1s;
    }
    .sot-scrub::-moz-range-thumb { width: 14px; height: 14px; border-radius: 999px; background: var(--color-card); border: 2px solid var(--color-ink); }
    .sot-scrub:active::-webkit-slider-thumb { transform: scale(1.15); }
    .sot-scrub:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--color-accent); outline-offset: 3px; }

    @media (prefers-reduced-motion: reduce) {
      .sot-overlay, .sot-card, .sot-part, .sot-drawing, .sot-sea, .sot-spark { transition: none; animation: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var overlay = document.getElementById('theseus-modal');
      var link = document.getElementById('theseus-link');
      if (!overlay || !link) return;

      var card = overlay.querySelector('.sot-card');
      var scrub = document.getElementById('sot-scrub');
      var scene = document.getElementById('sot-scene');
      var parts = Array.prototype.slice.call(overlay.querySelectorAll('.sot-part'));
      var sail = document.getElementById('sot-sail');
      var sky = document.getElementById('sot-sky');
      var sun = document.getElementById('sot-sun');
      var stateEl = document.getElementById('sot-state');
      var verdict = overlay.querySelector('.sot-verdict');
      var sparks = document.getElementById('sot-sparks');
      var lastFocus = null, curText = '';

      parts.forEach(function (p, i) { p.dataset.threshold = String((i + 0.6) / (parts.length + 0.4)); p.dataset.on = ''; });
      function clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
      function lerp(a, b, t) { return a + (b - a) * t; }
      function mix(c1, c2, t) {
        return 'rgb(' + Math.round(lerp(c1[0], c2[0], t)) + ',' + Math.round(lerp(c1[1], c2[1], t)) + ',' + Math.round(lerp(c1[2], c2[2], t)) + ')';
      }
      var sunOld = [205, 219, 226], sunNew = [255, 214, 130];

      function emitSparks() {
        for (var i = 0; i < 5; i++) {
          var s = document.createElement('span');
          s.className = 'sot-spark';
          s.style.left = (38 + Math.random() * 44) + '%';
          s.style.top = (52 + Math.random() * 22) + '%';
          s.style.setProperty('--dx', (Math.random() * 24 - 12) + 'px');
          s.style.animationDelay = (Math.random() * 0.12) + 's';
          sparks.appendChild(s);
          setTimeout(function (el) { return function () { el.remove(); }; }(s), 1300);
        }
      }

      function setText(txt, wavering) {
        verdict.classList.toggle('is-wavering', !!wavering);
        if (txt === curText) return;
        curText = txt;
        verdict.classList.add('is-swap');
        setTimeout(function () { stateEl.textContent = txt; verdict.classList.remove('is-swap'); }, 180);
      }

      function render(t, animate) {
        parts.forEach(function (p) {
          var on = t >= Number(p.dataset.threshold);
          if (on && p.dataset.on !== '1' && animate) emitSparks();
          p.dataset.on = on ? '1' : '';
          p.classList.toggle('is-new', on);
        });
        var s = Math.round(clamp01((t - 0.05) / 0.85) * 100);
        sail.style.fill = 'color-mix(in srgb, var(--sail-new) ' + s + '%, var(--sail-old))';

        // sky dawn -> dusk, sun rises and warms
        sky.setAttribute('opacity', t.toFixed(3));
        card.style.setProperty('--sun-core', mix(sunOld, sunNew, t));
        sun.setAttribute('cx', lerp(110, 372, t).toFixed(1));
        sun.setAttribute('cy', lerp(206, 96, t).toFixed(1));
        sun.setAttribute('r', lerp(30, 40, t).toFixed(1));

        if (t <= 0.001) setText('the old ship', false);
        else if (t >= 0.999) setText('the new ship', false);
        else if (t >= 0.32 && t <= 0.68) setText('the same ship?', true);
        else if (t < 0.5) setText('mostly the old ship', false);
        else setText('mostly the new ship', false);
      }

      // drag anywhere on the scene to scrub
      var dragging = false;
      function scrubFromX(clientX) {
        var r = scene.getBoundingClientRect();
        var t = clamp01((clientX - r.left) / r.width);
        scrub.value = Math.round(t * 100);
        scene.classList.add('is-touched');
        render(t, true);
      }
      scene.addEventListener('pointerdown', function (e) { dragging = true; scene.setPointerCapture(e.pointerId); scrubFromX(e.clientX); });
      scene.addEventListener('pointermove', function (e) { if (dragging) scrubFromX(e.clientX); });
      scene.addEventListener('pointerup', function () { dragging = false; });
      scene.addEventListener('pointercancel', function () { dragging = false; });

      function reset() { scrub.value = 0; scene.classList.remove('is-touched'); render(0, false); }

      function open() {
        lastFocus = document.activeElement;
        overlay.hidden = false;
        requestAnimationFrame(function () { overlay.classList.add('is-open'); });
        reset(); card.focus();
        document.addEventListener('keydown', onKey);
      }
      function close() {
        overlay.classList.remove('is-open');
        document.removeEventListener('keydown', onKey);
        setTimeout(function () { overlay.hidden = true; }, 300);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function onKey(e) { if (e.key === 'Escape') close(); }

      link.addEventListener('click', function (e) { e.preventDefault(); open(); });
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay || e.target.hasAttribute('data-theseus-close')) close();
      });
      scrub.addEventListener('input', function () { scene.classList.add('is-touched'); render(Number(scrub.value) / 100, true); });
    })();
  </script>
</BaseLayout>
