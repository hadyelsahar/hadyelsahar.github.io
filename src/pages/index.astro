---
// Homepage: classic academic layout.
// Header → Selected projects (carousel) → Research journey (2014→now, with figures + selected papers) → Writing.

import BaseLayout from '../layouts/BaseLayout.astro';
// import Eyebrow from '../components/Eyebrow.astro'; // used only by the (disabled) Writing section
import LinkChip from '../components/LinkChip.astro';
import { withBase } from '../lib/url.ts';
import { papers } from '../data/papers.ts';
import { projects } from '../data/projects.ts';
// Temporarily disabled with the Writing section:
// import { getCollection } from 'astro:content';

// const allPosts = await getCollection('posts', ({ data }) => !data.draft);
// const latestPosts = allPosts
//   .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
//   .slice(0, 3);

// const fmtDate = (d: Date) =>
//   d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const paperById = Object.fromEntries(papers.map((p) => [p.id, p]));
const eraPapers: Record<string, string[]> = {
  phd: ['paper-qg-kg', 'paper-wikidata', 'paper-neural-wikipedian', 'paper-wiki-underserved'],
  naver: ['paper-gdc', 'paper-cdpg', 'paper-rl-distribution', 'paper-approx-sampler'],
  seamless: ['paper-seamless', 'paper-nature-100lang'],
  contentseal: ['paper-text-seal', 'paper-pixel-seal', 'paper-chunky-seal', 'paper-video-seal', 'paper-audio-seal'],
};
const papersFor = (key: string) => (eraPapers[key] ?? []).map((id) => paperById[id]).filter(Boolean);

const contactLinks = [
  { label: 'Email', href: 'mailto:hadyelsahar@gmail.com' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?hl=en&user=SbcM6bsAAAAJ' },
  { label: 'GitHub', href: 'https://github.com/hadyelsahar' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hadyelsahar/' },
  { label: 'Hugging Face', href: 'https://huggingface.co/hadyelsahar' },
];
---

<BaseLayout title="Hady Elsahar" description="Hady Elsahar, Staff Research Scientist at FAIR, Meta Superintelligence Labs. Generative AI and safety: invisible watermarking, content provenance, multilingual & multimodal generation.">

  <!-- ============================================================ HEADER -->
  <section class="mx-auto max-w-[900px] px-6 pt-12 md:pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_212px] gap-x-10 gap-y-8 items-start">

      <!-- LEFT: name + bio -->
      <div>
        <div class="flex items-center gap-4">
          <img
            class="profile-pic md:hidden w-[68px] shrink-0 aspect-[5/6] object-cover rounded-[8px] border border-border"
            src={withBase('/assets/profile.jpg')}
            data-still={withBase('/assets/profile.jpg')}
            data-anim={withBase('/assets/avatar-coding.gif')}
            data-sleep={withBase('/assets/avatar-sleep.gif')}
            alt="Hady Elsahar"
            width="212" height="254"
          />
          <h1 class="font-display text-[40px] md:text-[58px] font-semibold tracking-[-0.02em] leading-[0.95] text-ink">Hady Elsahar</h1>
        </div>
        <p class="mt-4 text-[17px] leading-[1.5] text-ink-soft">
          Staff Research Scientist at <a href="https://ai.meta.com/" target="_blank" rel="noopener" class="link font-medium">FAIR, Meta Superintelligence Labs</a>, on the
          <a href="https://facebookresearch.github.io/content-seal/" target="_blank" rel="noopener" class="link font-medium">Content Seal</a> team.
          I work at the intersection of <span class="font-medium">generative AI and safety</span>, currently on invisible watermarking
          and content provenance, helping scale AI-generated-media detection to billions of users
          and protecting millions of videos a day.
        </p>

        <div class="mt-6 space-y-4 text-[14.5px] leading-[1.7] text-ink-soft">
          <p>
            I've worked in generative AI since 2014—back when we still derived gradients by hand
            and trained stacked LSTMs before autodiff made it effortless. Since then I've had a
            front-row seat to the field's evolution: from teaching models to copy words they had never seen
            before, to generating text in any language and steering what models say, to today's harder
            question: telling what's real in the age of deepfakes.
          </p>
          <p>
            At Meta, beyond Content Seal, I helped build <span class="font-medium text-ink">SeamlessM4T</span>,
            a single model for speech translation across close to 100 languages, named a
            <a class="link" href="https://time.com/collection/best-inventions-2023/6326994/meta-seamlessm4t/" target="_blank" rel="noopener">TIME Best Invention of 2023</a>
            and <a class="link" href="https://www.nature.com/articles/s41586-024-08359-z" target="_blank" rel="noopener">published in Nature</a>. Before Meta, at <a href="https://europe.naverlabs.com/" target="_blank" rel="noopener" class="link font-medium">Naver Labs Europe</a>,
            I worked with Marc Dymetman on reinforcement learning for fine-tuning language models
            <span class="font-medium text-ink">without catastrophic forgetting</span>—foundational research into
            RL-based alignment. Earlier, I was at
            <span class="font-medium text-ink">Bloomberg</span>, IBM, and Microsoft, and did my Ph.D. at
            Université de Lyon with <a href="https://twitter.com/chgravier" target="_blank" rel="noopener" class="link">Christophe Gravier</a>
            and Frédérique Laforest on generating natural language from knowledge graphs.
          </p>
          <p>
            Beyond research, I was a board member of <a href="https://www.masakhane.io/" target="_blank" rel="noopener" class="link font-medium">Masakhane</a>, whose
            participatory-research paper received the <a href="https://research.wikimedia.org/awards.html" target="_blank" rel="noopener" class="link">Wikimedia Foundation Research Award</a>,
and I helped organize <a href="https://africanlp.github.io/" target="_blank" rel="noopener" class="link font-medium">AfricaNLP</a>. I care about making AI work for underrepresented
            languages and communities.
          </p>
          <p>
            <span class="font-medium text-ink">Open to mentorship.</span> If you're an early-career researcher from an
            underrepresented group and want advice or encouragement, feel free to
            <a class="link" href="mailto:hadyelsahar@gmail.com">reach out</a>.
          </p>
        </div>

        <p class="mt-6 text-[13px] leading-[1.6] text-muted border-l-2 border-accent/50 pl-4">
          <span class="font-medium text-ink-soft">No borders, free identities.</span> We treat borders as
          physical realities and identities as fixed labels. I see them differently: borders are constructs
          we choose to believe in, and identity is a <a class="link" href="https://en.wikipedia.org/wiki/Ship_of_Theseus" target="_blank" rel="noopener">Ship of Theseus</a>.
        </p>
      </div>

      <!-- RIGHT: sticky sidebar -->
      <aside class="md:sticky md:top-[72px] self-start">
        <img
          class="profile-pic hidden md:block md:w-full aspect-[5/6] object-cover rounded-[8px] border border-border transition-shadow hover:shadow-lg"
          src={withBase('/assets/profile.jpg')}
          data-still={withBase('/assets/profile.jpg')}
          data-anim={withBase('/assets/avatar-coding.gif')}
          data-sleep={withBase('/assets/avatar-sleep.gif')}
          alt="Hady Elsahar"
          width="212" height="254"
        />

        <ul class="mt-5 grid grid-cols-2 md:grid-cols-1 gap-x-4 gap-y-1.5 text-[13px]">
          {contactLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-accent hover:text-accent-strong">
                {l.label}<span aria-hidden="true" class="text-muted-2">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <ul class="mt-5 space-y-1 text-[11.5px] leading-[1.5] text-muted">
          <li dir="rtl" lang="ar">العربية هي لغتي الأم.</li>
          <li lang="en">I speak English at a near-native level.</li>
          <li lang="fr">Je parle français à un niveau intermédiaire avancé.</li>
          <li lang="de">Ich spreche Deutsch auf mittlerem Niveau.</li>
          <li lang="ko">저는 한국어를 초급 수준으로 구사합니다.</li>
        </ul>
      </aside>

    </div>
  </section>

  <script is:inline>
    (function () {
      var imgs = Array.prototype.slice.call(document.querySelectorAll('.profile-pic'));
      if (!imgs.length) return;
      var first = imgs[0];
      var still = first.getAttribute('data-still');
      var anim = first.getAttribute('data-anim');
      var sleep = first.getAttribute('data-sleep');
      var hoverTimer = null, idleTimer = null, hovering = false;
      // Preload both gifs so swaps are instant.
      [anim, sleep].forEach(function (s) { var p = new Image(); p.src = s; });

      function setAll(src) { imgs.forEach(function (im) { im.src = src; }); }
      function isSleeping() { return first.src.indexOf('avatar-sleep') > -1; }
      function showStill() { setAll(still); }

      imgs.forEach(function (im) {
        // Hover for 1s -> coding gif.
        im.addEventListener('mouseenter', function () {
          hovering = true;
          if (hoverTimer) return;
          hoverTimer = setTimeout(function () { setAll(anim + '?t=' + Date.now()); }, 1000);
        });
        im.addEventListener('mouseleave', function () {
          hovering = false;
          if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
          showStill();
          resetIdle();
        });
      });

      // No scroll for 10s -> sleeping gif. Any scroll wakes it up.
      function resetIdle() {
        if (idleTimer) clearTimeout(idleTimer);
        if (!hovering && isSleeping()) showStill();
        idleTimer = setTimeout(function () {
          if (!hovering) setAll(sleep + '?t=' + Date.now());
        }, 10000);
      }
      window.addEventListener('scroll', resetIdle, { passive: true });
      resetIdle();
    })();
  </script>

  <!-- ============================================================ SELECTED PROJECTS -->
  <section id="projects" class="reveal mx-auto max-w-[900px] px-6 py-12 border-t border-border">
    <div class="flex items-end justify-between gap-6 mb-6 pb-2 border-b border-border">
      <h2 class="font-display text-[15px] font-semibold tracking-tight text-ink">Selected projects</h2>
      <div class="flex items-center gap-2">
        <button data-proj-scroll="-1" aria-label="Previous project" class="h-8 w-8 rounded-full border border-border text-muted hover:text-ink hover:border-ink transition-colors leading-none">←</button>
        <button data-proj-scroll="1" aria-label="Next project" class="h-8 w-8 rounded-full border border-border text-muted hover:text-ink hover:border-ink transition-colors leading-none">→</button>
      </div>
    </div>

    <div id="proj-track" class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-6 px-6" style="scrollbar-width:none;">
      {projects.map((p) => (
        <article class="snap-start shrink-0 w-[300px] sm:w-[440px] border border-border rounded-[10px] overflow-hidden bg-card flex flex-col">
          <div class:list={["group/cover relative aspect-[16/9] border-b border-border overflow-hidden", p.imageContain ? "bg-bg-subtle flex items-center justify-center p-3" : "bg-bg-subtle"]}>
            <img src={withBase(p.image)} alt={p.title} loading="lazy" class:list={[p.imageContain ? "max-h-full w-auto object-contain" : "w-full h-full object-cover", p.imagePos]} />
            {p.cover && (
              <a href={p.cover.href} target="_blank" rel="noopener" aria-label={p.cover.hint} class="absolute inset-0 flex items-end">
                <span class="w-full translate-y-1.5 opacity-0 group-hover/cover:translate-y-0 group-hover/cover:opacity-100 transition-all duration-200 bg-gradient-to-t from-black/75 via-black/40 to-transparent px-3 pt-7 pb-2 font-mono text-[10.5px] tracking-wide text-white">
                  {p.cover.hint} <span aria-hidden="true">↗</span>
                </span>
              </a>
            )}
          </div>
          <div class="p-5 flex flex-col flex-1">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent">{p.period}</p>
            <h3 class="mt-1 font-serif text-[19px] font-semibold text-ink leading-tight">{p.title}</h3>
            <p class="mt-2 text-[13px] leading-[1.55] text-ink-soft" set:html={p.blurb}></p>

            {p.gallery && p.gallery.length > 0 && (
              <div class="mt-4 flex gap-2">
                {p.gallery.map((g) => (
                  <a href={g.href} target="_blank" rel="noopener" class="group/g relative block flex-1 min-w-0" aria-label={g.hint ?? g.alt} title={g.hint ?? g.alt}>
                    <div class="aspect-[16/10] rounded-[5px] border border-border overflow-hidden bg-bg-subtle">
                      <img src={withBase(g.img)} alt={g.alt} loading="lazy" class:list={["w-full h-full object-cover group-hover/g:opacity-90 transition-opacity", g.pos]} />
                    </div>
                    {g.hint && (
                      <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-1 opacity-0 group-hover/g:translate-y-0 group-hover/g:opacity-100 transition-all duration-200 bg-gradient-to-t from-black/75 to-transparent px-2 pt-5 pb-1.5 font-mono text-[9.5px] tracking-wide text-white rounded-b-[5px]">
                        {g.hint} <span aria-hidden="true">↗</span>
                      </span>
                    )}
                  </a>
                ))}
              </div>
            )}

            {p.press.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.press.map((l) => (
                  <LinkChip label={l.label} href={l.href} />
                ))}
              </div>
            )}

            {p.links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {p.links.map((l) => (
                  <LinkChip label={l.label} href={l.href} />
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var track = document.getElementById('proj-track');
      if (!track) return;
      var card = track.querySelector('article');
      var step = card ? card.offsetWidth + 20 : 380;
      document.querySelectorAll('[data-proj-scroll]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          track.scrollBy({ left: Number(btn.getAttribute('data-proj-scroll')) * step, behavior: 'smooth' });
        });
      });
    })();
  </script>

  <!-- ============================================================ RESEARCH JOURNEY -->
  <section id="research" class="reveal mx-auto max-w-[900px] px-6 py-12 border-t border-border">
    <div class="flex items-baseline justify-between gap-6 mb-6 pb-2 border-b border-border">
      <h2 class="font-serif text-[15px] font-semibold tracking-tight text-ink">Research journey</h2>
      <button
        id="journey-flip"
        type="button"
        aria-pressed="true"
        aria-label="Reverse the timeline order"
        class="group font-mono text-[10px] tracking-widest text-muted-2 uppercase inline-flex items-center gap-1.5 hover:text-accent transition-colors"
      >
        <span data-journey-label>Today → 2014</span>
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:rotate-180">⇅</span>
      </button>
    </div>

    <p class="mb-10 text-[13px] text-muted">
      Full, always-current publication list on
      <a class="link" href="https://scholar.google.com/citations?hl=en&user=SbcM6bsAAAAJ">Google Scholar</a> and
      <a class="link" href="https://dblp.uni-trier.de/pers/hd/e/ElSahar:Hady">DBLP</a>.
    </p>

    <div id="journey" class="flex flex-col-reverse gap-12">

      <!-- PhD -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2014 – 2018</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Ph.D., Université de Lyon</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Knowledge-grounded generation &amp; copy mechanisms for language models</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            My thesis addressed data-to-text generation and relation extraction, in the pre-Transformer era
            when models were still small enough to reason about by hand. I worked on
            <span class="font-medium text-ink">out-of-vocabulary tokens and copy actions</span> (early attention
            and pointer mechanisms, from a time when named entities were a plague before byte-pair encoding),
            and on conditioning recurrent language models (stacked LSTMs / GRUs) on
            <span class="font-medium text-ink">retrieved knowledge-base facts</span> via early KB embeddings
            (TransE): in retrospect, a precursor to retrieval-augmented generation (RAG). Attention of this kind
            is what self-attention would soon scale into the default way the world trains language models.
          </p>
          <figure class="mt-5">
            <img src={withBase('/assets/figures/fig-qg-kg.png')} alt="Zero-shot question generation model with a fact encoder, textual context encoders, and a copy-action GRU decoder using GloVe and TransE embeddings" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
            <figcaption class="mt-2 text-[12px] text-muted">
              A GRU decoder with part-of-speech copy actions, conditioned on knowledge-base facts (TransE) and textual context.
            </figcaption>
          </figure>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('phd').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Bloomberg -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2018</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Bloomberg, London</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Neural abstractive summarization in production</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            I spent a year extending my summarization research into a
            <span class="font-medium text-ink"> summarization engine now deployed at scale in the Bloomberg
            Terminal</span>, an early lesson in taking neural generation from paper to product.
          </p>
          <figure class="mt-5">
            <a href="https://www.youtube.com/watch?v=2he8Jgmjo9M" target="_blank" rel="noopener" class="group relative block overflow-hidden rounded-[6px] border border-border bg-figure">
              <img src={withBase('/assets/figures/bloomberg-nstm.jpg')} alt="Bloomberg Terminal NSTM (Key News Themes) output, grouping news into summarized themes" loading="lazy" class="w-full transition-transform duration-300 group-hover:scale-[1.02]" />
              <span class="pointer-events-none absolute inset-0 grid place-items-center">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-black/55 text-white text-[17px] pl-1 backdrop-blur-sm transition-colors group-hover:bg-accent">▶</span>
              </span>
            </a>
            <figcaption class="mt-2 text-[12px] text-muted">
              Bloomberg Terminal, NSTM (Key News Themes). The summarization engine ships under <span class="font-mono text-[11px] text-ink-soft">NSTM &lt;GO&gt;</span>. Click to watch the demo.
            </figcaption>
          </figure>
        </div>
      </article>

      <!-- Naver -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2019 – 2022</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Naver Labs Europe</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Reinforcement learning for language models, without catastrophic forgetting</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            With Marc Dymetman, I studied fine-tuning language models under reinforcement learning while
            <span class="font-medium text-ink"> avoiding catastrophic forgetting</span>—an early approach to
            RL-based alignment. We formalized control as constraint satisfaction over distributions, solved via
            Energy-Based Models and distributional policy gradients.
          </p>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
            <figure>
              <img src={withBase('/assets/figures/fig-gdc.png')} alt="Information-geometry diagram: projecting from a Maximum-Entropy specification to an Energy-Based Model" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
              <figcaption class="mt-2 text-[12px] text-muted">Distributional control via Information Geometry.</figcaption>
            </figure>
            <figure>
              <img src={withBase('/assets/figures/fig-cdpg.png')} alt="Training curves showing Reinforce collapsing in BLEU-4 while CDPG maintains quality" loading="lazy" class="w-full rounded-[6px] border border-border bg-figure" />
              <figcaption class="mt-2 text-[12px] text-muted">Standard RL (Reinforce) catastrophically loses quality; CDPG satisfies the constraint while preserving it.</figcaption>
            </figure>
          </div>
          <div class="mt-6 pt-4 border-t border-border">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted-2">Selected papers</p>
            <ul class="mt-2 space-y-2">
              {papersFor('naver').map((p) => (
                <li class="text-[13px] leading-snug">
                  <span class="text-ink-soft">{p.title}</span><span class="text-muted"> · {p.venue}</span>
                  {p.links.map((l) => (<a href={l.href} target="_blank" rel="noopener" class="ml-1.5 text-[12px] text-accent hover:text-accent-strong">[{l.label}]</a>))}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Meta Seamless -->
      <article class="reveal grid grid-cols-1 md:grid-cols-[160px_1fr] gap-x-8 gap-y-3">
        <div class="md:sticky md:top-[76px] self-start">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">2022 – 2024</p>
          <p class="mt-0.5 text-[13px] font-medium text-ink leading-snug">Meta AI - FAIR</p>
        </div>
        <div class="md:border-l md:border-border md:pl-8">
          <h3 class="font-serif text-[21px] font-semibold text-ink leading-tight">Seamless: Massively multilingual &amp; multimodal translation</h3>
          <p class="mt-3 text-[14.5px] leading-[1.7] text-ink-soft">
            I joined the Seamless effort and helped build <span class="font-medium text-ink">SeamlessM4T</span>,
            a single foundation model for direct speech-to-speech and speech-to-text translation across close to
            100 languages. It was named one of
            <a class="link" href="https://time.com/collection/best-inventions-2023/6326994/meta-seamlessm4t/">Time's Best Inventions of 2023</a>,
            and published in <a class="link" href="https://www.nature.com/articles/s41586-024-08359-z">Nature (2025)</a>.
          </p>
          <div class="mt-6">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {[
                { v: 'excited', label: 'Excited', lang: '→ German' },
                { v: 'fast-talking', label: 'Fast talking', lang: '→ French' },
                { v: 'sad', label: 'Sad', lang: '→ Spanish' },
                { v: 'whispering', label: 'Whispering', lang: '→ English' },
              ].map((d) => (
                <figure>
                  <video class="w-full aspect-square object-cover rounded-[6px] border border-border bg-figure" controls preload="none" playsinline poster={withBase(`/assets/demos/seamless/${d.v}.png`)}>
                    <source src={withBase(`/assets/demos/seamless/${d.v}.mp4`)} type="video/mp4" />
                  </video>
